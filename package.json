{
  "name": "gbgabiola",
  "version": "4.2.2",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:blog && next build",
    "validate:blog": "node scripts/validate-blog.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test:content": "node --test scripts/validate-blog.test.mjs scripts/article-sections.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "hast-util-to-string": "3.0.1",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
