{
  "name": "gbgabiola",
  "version": "5.0.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run validate:blog && astro build",
    "validate:blog": "node scripts/validate-blog.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "test:content": "node --test scripts/validate-blog.test.mjs scripts/article-sections.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "astro check",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "astro": "7.4.13",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.16.0",
    "eslint-plugin-astro": "3.2.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "type": "module"
}
