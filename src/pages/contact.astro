---
import {
  faGithub,
  faLinkedin,
  faTwitter,
} from '@fortawesome/free-brands-svg-icons';
import { faEnvelope } from '@fortawesome/free-solid-svg-icons';
import { profile } from '@/content/profile';
import ResumeLink from '@/components/ui/resume-link.astro';
import styles from '@/styles/contact.module.css';
const socialIcons = {
  linkedin: faLinkedin,
  twitter: faTwitter,
  github: faGithub,
};
import ContactIcon from '@/components/ui/contact-icon.astro';
import Layout from '@/layouts/Base.astro';
---

<Layout
  title="Contact"
  description="Get in touch with G about part-time remote work and web projects."
>
  <div class="viewport-page">
    <header>
      <h1>Let’s build something useful.</h1>
      <p class="intro-copy">
        {profile.availability} Tell me what you’re building.
      </p>
    </header>

    <div class={styles.grid}>
      <section class={styles.card} aria-labelledby="contact-heading">
        <h2 id="contact-heading">Get in touch</h2>
        <ul class={styles.links}>
          <li>
            <a href={`mailto:${profile.email}`}>
              <ContactIcon definition={faEnvelope} />
              {profile.email}
            </a>
          </li>
          {profile.socialLinks.map(({ platform, label, username, href }) => (
            <li>
              <a href={href} aria-label={`${label}: ${username}`}>
                <ContactIcon definition={socialIcons[platform]} />
                {username}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class={styles.card} aria-labelledby="resume-heading">
        <h2 id="resume-heading">Experience at a glance</h2>
        <div class={styles.actions}>
          <ResumeLink />
          <a href={profile.resume.viewUrl}>View online</a>
        </div>
      </section>
    </div>
  </div>
</Layout>
